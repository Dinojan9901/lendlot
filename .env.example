# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose.yml (note port 5433)
DATABASE_URL="postgresql://lendlot:lendlot@localhost:5433/lendlot"
# Separate database for integration + E2E tests
TEST_DATABASE_URL="postgresql://lendlot:lendlot@localhost:5433/lendlot_test"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Public base URL, used for Open Graph and absolute links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Paddle SANDBOX (the app only ever talks to sandbox-api.paddle.com).
# From the Paddle sandbox dashboard → Developer tools → Authentication:
PADDLE_API_KEY=""
# Client-side token (starts with test_). Public by design: it can only open checkouts.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Printed by `npm run billing:setup`
PADDLE_PRICE_ID=""
# Written by `npm run billing:setup -- --webhook-url=...` to .env.paddle-webhook.local
PADDLE_WEBHOOK_SECRET=""
