# Copy to .env and adjust. Never commit .env.

# Local Postgres from docker-compose.yml (note port 5433)
DATABASE_URL="postgresql://lendlot:lendlot@localhost:5433/lendlot"
# Separate database for integration + E2E tests
TEST_DATABASE_URL="postgresql://lendlot:lendlot@localhost:5433/lendlot_test"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Public base URL, used for Open Graph and absolute links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe TEST mode only (the app refuses sk_live_ keys).
# Get the secret key from the Stripe dashboard (Developers → API keys, test mode),
# then run `npm run stripe:setup` to create the price and print STRIPE_PRICE_ID.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
# Signing secret of the webhook endpoint (created by stripe:setup for a public URL)
STRIPE_WEBHOOK_SECRET=""
